# ── Go build outputs ────────────────────────────────────────────────
# Compiled binaries (raw and encoded)
**/**/src/*-amd64
**/**/src/*-arm64
system-vms/blockstore/src/blockstore-node-amd64
system-vms/blockstore/src/blockstore-node-arm64

# Encoded build artifacts (old gz+b64 format — not used in new pipeline)
**/*.gz.b64
**/*.b64

# Go toolchain caches (auto-downloaded by build.sh self-bootstrapping)
**/src/.go-*
**/src/.gopath/
**/src/.gocache/

# Go module download cache
**/vendor/

# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# ── OS ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Secrets (should never be committed) ─────────────────────────────
*.pem
*.key
*.env
.env.*
!.env.example
**/artifact-constants.*