# DeCloud.Builds — line ending policy
# All text files normalized to LF in the repository.
# Windows contributors get LF on checkout (no conversion).

* text=auto eol=lf

# Shell scripts must always be LF — hard requirement for shebang resolution
*.sh text eol=lf

# Cloud-init files
*.yaml text eol=lf
*.yml  text eol=lf

# Python artifacts
*.py   text eol=lf

# JSON/config
*.json text eol=lf
*.conf text eol=lf
*.env  text eol=lf

# Binaries — never touch
*.qcow2 binary
*.iso   binary
*.gz    binary
*.zip   binary